# LLM Provider Configuration
# Options: mock, openai, openrouter, gemini, lmstudio
LLM_PROVIDER=mock

# API Keys (leave blank if using 'mock' provider)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=ChronoRAG

# Google AI Studio (Gemini) — free tier ~15 RPM, OpenAI-compatible endpoint.
# Get key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Local LM Studio server (no real API key required)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen/qwen3-4b

# Chat LLM call layer
# requests = direct OpenAI-compatible call, recommended for LM Studio demo.
# langchain = try LangChain ChatOpenAI wrapper first, then fallback to raw requests.
CHAT_ANSWERER=requests
