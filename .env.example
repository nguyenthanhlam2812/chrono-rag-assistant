# LLM Provider Configuration
# Options: mock, openai, openrouter, lmstudio
LLM_PROVIDER=mock

# API Keys (leave blank if using 'mock' provider)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=ChronoRAG

# Local LM Studio server (no real API key required)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen/qwen3-4b

# Chat intent router
# rules = deterministic routing; langchain = optional LLM intent classifier
CHAT_ROUTER=rules
