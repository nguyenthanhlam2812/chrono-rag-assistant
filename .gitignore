!.gitkeep

# Local development logs
*.log

# Streamlit local secrets
.streamlit/secrets.toml

# Sprint planning / approval docs (kept local, history lives in commits)
docs/SPRINT_*_PLAN.md
docs/SPRINT_*_APPROVAL.md

# One-time conversion scripts (not part of the pipeline)
scripts/clean_autogen.py

# Raw scraping intermediates
data/raw/**/*_raw.html

# Scratch / experimentation
scratch/

# React/Vite frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
