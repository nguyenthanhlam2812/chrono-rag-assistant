# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environment variables
.env
.env.local
frontend/.env.local

# Virtual environments
venv/
.venv/
env/

# IDE files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local AI assistant/tooling files
.claude/
CLAUDE.md

# ChronoRAG specific exclusions
data/vector_db/*
data/processed/*
data/labeled/splits/*
data/demo_outputs/*
data/raw/**/*.pdf
models/*.pkl
models/*.pt
saved_models/*.pkl
saved_models/*.pt
